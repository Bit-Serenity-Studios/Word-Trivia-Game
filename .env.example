# The Athenaeum — environment variables
# Copy to .env.local and fill in real values. Every var is inlined into the
# app bundle at build time by Expo/Metro. Nothing here is a secret in the
# cryptographic sense — treat these as public identifiers.

# --- PostHog (analytics) ----------------------------------------------------
# When set, session_start / entry_solved / rank_up / etc fire against PostHog.
# When unset, TelemetryProvider falls back to Console (dev) or Null (prod).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Google AdMob (rewarded + interstitial + banner) -------------------------
# Set EXPO_PUBLIC_USE_REAL_ADS=1 to activate real AdMob; leave unset for stubs.
EXPO_PUBLIC_USE_REAL_ADS=0
# Set to 0 for production; 1 uses Google's public "always-fill" test unit ids.
EXPO_PUBLIC_ADMOB_USE_TEST_IDS=1

# Rewarded — opt-in with a reward attached (never suppressed by patron)
EXPO_PUBLIC_ADMOB_UNIT_POST_SOLVE=
EXPO_PUBLIC_ADMOB_UNIT_FAILURE_RESCUE=
EXPO_PUBLIC_ADMOB_UNIT_ARCHIVIST=

# Interstitial — forced, after each solve (patron-suppressed, cadence-limited)
EXPO_PUBLIC_ADMOB_UNIT_INTERSTITIAL=

# Banner — persistent on Cabinet / Store / Settings (patron-suppressed)
EXPO_PUBLIC_ADMOB_UNIT_BANNER=

# --- RevenueCat (in-app purchases) ------------------------------------------
# Set EXPO_PUBLIC_USE_REAL_IAP=1 to activate real RevenueCat; leave unset for stubs.
EXPO_PUBLIC_USE_REAL_IAP=0
EXPO_PUBLIC_REVENUECAT_KEY_ANDROID=
EXPO_PUBLIC_REVENUECAT_KEY_IOS=
